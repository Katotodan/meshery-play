{"ast":null,"code":"import{useState,useEffect}from'react';export const useDarkMode=()=>{const[theme,setTheme]=useState('dark');const setMode=mode=>{window.localStorage.setItem('theme',mode);setTheme(mode);};const toggleTheme=()=>{theme==='dark'?setMode('light'):setMode('dark');};useEffect(()=>{const localTheme=window.localStorage.getItem('theme');localTheme?setTheme(localTheme):setMode('dark');},[]);return[theme,toggleTheme];};","map":{"version":3,"names":["useState","useEffect","useDarkMode","theme","setTheme","setMode","mode","window","localStorage","setItem","toggleTheme","localTheme","getItem"],"sources":["/Users/danielkatoto/Desktop/open-source/meshery-play/site/src/components/useDarkMode.js"],"sourcesContent":["import { useState, useEffect } from 'react'\n\nexport const useDarkMode = () => {\n  const [ theme, setTheme ] = useState('dark');\n\n  const setMode = mode => {\n    window.localStorage.setItem('theme', mode);\n    setTheme(mode);\n  }\n\n  const toggleTheme = () => {\n    theme === 'dark' ? setMode('light') : setMode('dark');\n  }\n\n  useEffect(() => {\n    const localTheme = window.localStorage.getItem('theme');\n    localTheme ? setTheme(localTheme) : setMode('dark');\n  }, []);\n  \n  return [ theme, toggleTheme ];\n}"],"mappings":"AAAA,OAASA,QAAQ,CAAEC,SAAS,KAAQ,OAAO,CAE3C,MAAO,MAAM,CAAAC,WAAW,CAAGA,CAAA,GAAM,CAC/B,KAAM,CAAEC,KAAK,CAAEC,QAAQ,CAAE,CAAGJ,QAAQ,CAAC,MAAM,CAAC,CAE5C,KAAM,CAAAK,OAAO,CAAGC,IAAI,EAAI,CACtBC,MAAM,CAACC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAEH,IAAI,CAAC,CAC1CF,QAAQ,CAACE,IAAI,CAAC,CAChB,CAAC,CAED,KAAM,CAAAI,WAAW,CAAGA,CAAA,GAAM,CACxBP,KAAK,GAAK,MAAM,CAAGE,OAAO,CAAC,OAAO,CAAC,CAAGA,OAAO,CAAC,MAAM,CAAC,CACvD,CAAC,CAEDJ,SAAS,CAAC,IAAM,CACd,KAAM,CAAAU,UAAU,CAAGJ,MAAM,CAACC,YAAY,CAACI,OAAO,CAAC,OAAO,CAAC,CACvDD,UAAU,CAAGP,QAAQ,CAACO,UAAU,CAAC,CAAGN,OAAO,CAAC,MAAM,CAAC,CACrD,CAAC,CAAE,EAAE,CAAC,CAEN,MAAO,CAAEF,KAAK,CAAEO,WAAW,CAAE,CAC/B,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}